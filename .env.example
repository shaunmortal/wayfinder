# AI = Gemma 4 on this laptop via Ollama (`ollama pull gemma4:e2b-it-qat`). Without Ollama the app still routes offline.
GEMMA_MODEL=gemma4:e2b-it-qat
OLLAMA_URL=http://127.0.0.1:11434
# Demo only: shows a button that pretends 10 people are walking a route (never enable on a public server).
# RAASTA_DEMO=1

# Team-only link to read visitor feedback: /api/feedback?key=<this>
FEEDBACK_KEY=

# Faster option: put a Claude API key here and the AI runs in the cloud instead of Ollama (laptop stays free).
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
